<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>Snap Gallery</name>
    <author>Dious</author>
    <creationDate>2026-02</creationDate>
    <copyright>Copyright (C) 2018 Rich Court. Copyright (C) 2026 Dious.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorUrl>www.dious.fr</authorUrl>
    <version>6.1.6</version>
    <description>PLG_CONTENT_SNAP_GALLERY_DESCRIPTION</description>

    <namespace path="src">RichCourt\Plugin\Content\SnapGallery</namespace>

    <files>
        <folder plugin="snap_gallery">services</folder>
        <folder>src</folder>
        <folder>sql</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_content_snap_gallery.ini</language>
        <language tag="en-GB">language/en-GB/plg_content_snap_gallery.sys.ini</language>
        <language tag="fr-FR">language/fr-FR/plg_content_snap_gallery.ini</language>
        <language tag="fr-FR">language/fr-FR/plg_content_snap_gallery.sys.ini</language>
        <language tag="de-DE">language/de-DE/plg_content_snap_gallery.ini</language>
        <language tag="de-DE">language/de-DE/plg_content_snap_gallery.sys.ini</language>
        <language tag="es-ES">language/es-ES/plg_content_snap_gallery.ini</language>
        <language tag="es-ES">language/es-ES/plg_content_snap_gallery.sys.ini</language>
        <language tag="it-IT">language/it-IT/plg_content_snap_gallery.ini</language>
        <language tag="it-IT">language/it-IT/plg_content_snap_gallery.sys.ini</language>
    </languages>

    <media destination="plg_content_snap_gallery" folder="media">
        <folder>css</folder>
        <folder>js</folder>
        <folder>img</folder>
        <folder>rc_shadowbox</folder>
        <folder>shadowbox</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <install>
        <sql>
            <file driver="mysqli" charset="utf8">sql/install.sql</file>
        </sql>
    </install>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="quickstart" type="note" label="PLG_CONTENT_SNAP_GALLERY_QUICKSTART_LABEL"/>
                <field name="witheditorbutton" type="note" label="PLG_CONTENT_SNAP_GALLERY_WITHEDITORBUTTON_LABEL" description="PLG_CONTENT_SNAP_GALLERY_WITHEDITORBUTTON_DESC"/>
                <field name="withouteditorbutton" type="note" label="PLG_CONTENT_SNAP_GALLERY_WITHOUTEDITORBUTTON_LABEL" description="PLG_CONTENT_SNAP_GALLERY_WITHOUTEDITORBUTTON_DESC"/>
                <field name="moreinstructions" type="note" label="PLG_CONTENT_SNAP_GALLERY_MOREINSTRUCTIONS_LABEL" description="PLG_CONTENT_SNAP_GALLERY_MOREINSTRUCTIONS_DESC"/>
            </fieldset>
            <fieldset name="gallery" label="PLG_CONTENT_SNAP_GALLERY_FIELDSET_GALLERY">
                <field name="gallerydescription" type="note" label="PLG_CONTENT_SNAP_GALLERY_GALLERYDESCRIPTION_LABEL" description=""/>
                <field name="galleryfolder" type="text" default="images" label="PLG_CONTENT_SNAP_GALLERY_GALLERYFOLDER_LABEL" description="PLG_CONTENT_SNAP_GALLERY_GALLERYFOLDER_DESC"/>
                <field name="layout" type="radio" default="justified" label="PLG_CONTENT_SNAP_GALLERY_LAYOUT_LABEL" description="PLG_CONTENT_SNAP_GALLERY_LAYOUT_DESC">
                    <option value="justified">PLG_CONTENT_SNAP_GALLERY_LAYOUT_OPT_JUSTIFIED</option>
                    <option value="square_grid">PLG_CONTENT_SNAP_GALLERY_LAYOUT_OPT_SQUARE_GRID</option>
                </field>
                <field name="sorttype" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_SORTTYPE_DESC" label="PLG_CONTENT_SNAP_GALLERY_SORTTYPE_LABEL">
                    <option value="0">PLG_CONTENT_SNAP_GALLERY_SORTTYPE_OPT_FILENAME</option>
                    <option value="1">PLG_CONTENT_SNAP_GALLERY_SORTTYPE_OPT_DATE</option>
                    <option value="2">PLG_CONTENT_SNAP_GALLERY_SORTTYPE_OPT_RANDOM</option>
                </field>
                <field name="sortdesc" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_SORTDESC_DESC" label="PLG_CONTENT_SNAP_GALLERY_SORTDESC_LABEL">
                    <option value="0">PLG_CONTENT_SNAP_GALLERY_SORTDESC_OPT_ASCENDING</option>
                    <option value="1">PLG_CONTENT_SNAP_GALLERY_SORTDESC_OPT_DESCENDING</option>
                </field>
                <field name="minrowheight" type="text" default="100" description="PLG_CONTENT_SNAP_GALLERY_MINROWHEIGHT_DESC" label="PLG_CONTENT_SNAP_GALLERY_MINROWHEIGHT_LABEL"/>
                <field name="thumbquality" type="range" min="0" max="100" step="10" size="3" default="80" description="PLG_CONTENT_SNAP_GALLERY_THUMBQUALITY_DESC" label="PLG_CONTENT_SNAP_GALLERY_THUMBQUALITY_LABEL"/>
                <field name="imagemargin" type="number" default="2" description="PLG_CONTENT_SNAP_GALLERY_IMAGEMARGIN_DESC" label="PLG_CONTENT_SNAP_GALLERY_IMAGEMARGIN_LABEL"/>
                <field name="imageTitle" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_IMAGETITLE_DESC" label="PLG_CONTENT_SNAP_GALLERY_IMAGETITLE_LABEL">
                    <option value="0">PLG_CONTENT_SNAP_GALLERY_IMAGETITLE_OPT_HIDE</option>
                    <option value="1">PLG_CONTENT_SNAP_GALLERY_IMAGETITLE_OPT_HOVER</option>
                    <option value="2">PLG_CONTENT_SNAP_GALLERY_IMAGETITLE_OPT_ALWAYS</option>
                </field>
                <field name="usetitleasalt" type="radio" class="btn-group btn-group-yesno" default="1" description="PLG_CONTENT_SNAP_GALLERY_USETITLEASALT_DESC" label="PLG_CONTENT_SNAP_GALLERY_USETITLEASALT_LABEL">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="uselabelsfile" type="radio" class="btn-group btn-group-yesno" default="0" description="PLG_CONTENT_SNAP_GALLERY_USELABELSFILE_DESC" label="PLG_CONTENT_SNAP_GALLERY_USELABELSFILE_LABEL">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="shadowbox" label="PLG_CONTENT_SNAP_GALLERY_FIELDSET_SHADOWBOX">
                <field name="shadowboxdescription" type="note" label="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXDESCRIPTION_LABEL" description="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXDESCRIPTION_DESC"/>
                <field name="shadowboxoption" type="radio" default="3" description="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_DESC" label="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_LABEL">
                        <option value="3">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_OPT_BUILTIN</option>
                        <option value="0">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_OPT_LEGACY</option>
                        <option value="1">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_OPT_ANOTHER</option>
                        <option value="2">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXOPTION_OPT_NONE</option>
                </field>
                <field name="hidescrollbar" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_HIDESCROLLBAR_DESC" label="PLG_CONTENT_SNAP_GALLERY_HIDESCROLLBAR_LABEL">
                        <option value="0">PLG_CONTENT_SNAP_GALLERY_HIDESCROLLBAR_OPT_ALLOW</option>
                        <option value="1">PLG_CONTENT_SNAP_GALLERY_HIDESCROLLBAR_OPT_PREVENT</option>
                </field>
                <field name="shadowboxanimations" type="filelist" default="default" label="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXANIMATIONS_LABEL" directory="media/plg_content_snap_gallery/rc_shadowbox/css" filter="" exclude="default.css" stripext="true" hide_none="true" description="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXANIMATIONS_DESC"/>
            </fieldset>
            <fieldset name="appearance" label="PLG_CONTENT_SNAP_GALLERY_FIELDSET_APPEARANCE">
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_THUMBNAILS_NOTE_LABEL" description="PLG_CONTENT_SNAP_GALLERY_THUMBNAILS_NOTE_DESC"/>
                <field name="thumbbgcolour" label="PLG_CONTENT_SNAP_GALLERY_THUMBBGCOLOUR_LABEL" type="color" default="#f2f2f2" description="PLG_CONTENT_SNAP_GALLERY_THUMBBGCOLOUR_DESC"/>
                <field name="titletextcolour" label="PLG_CONTENT_SNAP_GALLERY_TITLETEXTCOLOUR_LABEL" type="color" default="#fff" description="PLG_CONTENT_SNAP_GALLERY_TITLETEXTCOLOUR_DESC"/>
                <field name="titletextsize" label="PLG_CONTENT_SNAP_GALLERY_TITLETEXTSIZE_LABEL" type="number" default="14" description="PLG_CONTENT_SNAP_GALLERY_TITLETEXTSIZE_DESC"/>
                <field name="titletextweight" type="radio" default="bold" description="PLG_CONTENT_SNAP_GALLERY_TITLETEXTWEIGHT_DESC" label="PLG_CONTENT_SNAP_GALLERY_TITLETEXTWEIGHT_LABEL">
                        <option value="bold">PLG_CONTENT_SNAP_GALLERY_TITLETEXTWEIGHT_OPT_BOLD</option>
                        <option value="normal">PLG_CONTENT_SNAP_GALLERY_TITLETEXTWEIGHT_OPT_NORMAL</option>
                </field>
                <field name="titletextalign" type="radio" default="left" description="PLG_CONTENT_SNAP_GALLERY_TITLETEXTALIGN_DESC" label="PLG_CONTENT_SNAP_GALLERY_TITLETEXTALIGN_LABEL">
                        <option value="left">JGLOBAL_LEFT</option>
                        <option value="center">JGLOBAL_CENTER</option>
                        <option value="right">JGLOBAL_RIGHT</option>
                </field>
                <field name="titletextoverflow" type="radio" default="hidden" description="PLG_CONTENT_SNAP_GALLERY_TITLETEXTOVERFLOW_DESC" label="PLG_CONTENT_SNAP_GALLERY_TITLETEXTOVERFLOW_LABEL">
                        <option value="hidden">PLG_CONTENT_SNAP_GALLERY_TITLETEXTOVERFLOW_OPT_HIDDEN</option>
                        <option value="auto">PLG_CONTENT_SNAP_GALLERY_TITLETEXTOVERFLOW_OPT_AUTO</option>
                </field>

                <field name="thumbnailradius" label="PLG_CONTENT_SNAP_GALLERY_THUMBNAILRADIUS_LABEL" type="number" default="0" description="PLG_CONTENT_SNAP_GALLERY_THUMBNAILRADIUS_DESC"/>
                <field name="thumbnailfilter" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_THUMBNAILFILTER_DESC" label="PLG_CONTENT_SNAP_GALLERY_THUMBNAILFILTER_LABEL">
                        <option value="0">PLG_CONTENT_SNAP_GALLERY_THUMBNAILFILTER_OPT_NONE</option>
                        <option value="1">PLG_CONTENT_SNAP_GALLERY_THUMBNAILFILTER_OPT_SEPIA</option>
                        <option value="2">PLG_CONTENT_SNAP_GALLERY_THUMBNAILFILTER_OPT_GREYSCALE</option>
                </field>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_SHADOWBOX_APPEARANCE_NOTE_LABEL" description="PLG_CONTENT_SNAP_GALLERY_SHADOWBOX_APPEARANCE_NOTE_DESC"/>
                <field name="shadowboxtitle" type="radio" default="0" description="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXTITLE_DESC" label="PLG_CONTENT_SNAP_GALLERY_SHADOWBOXTITLE_LABEL">
                        <option value="0">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXTITLE_OPT_SHOW</option>
                        <option value="1">PLG_CONTENT_SNAP_GALLERY_SHADOWBOXTITLE_OPT_HIDE</option>
                </field>
                <field name="overlaycolour" label="PLG_CONTENT_SNAP_GALLERY_OVERLAYCOLOUR_LABEL" type="color" default="rgba(0, 0, 0, .85)" format="rgba" description="PLG_CONTENT_SNAP_GALLERY_OVERLAYCOLOUR_DESC"/>
                <field name="overlayopacity" label="PLG_CONTENT_SNAP_GALLERY_OVERLAYOPACITY_LABEL" type="range" default="1" min="0" max="1" step="0.05" size="3" description="PLG_CONTENT_SNAP_GALLERY_OVERLAYOPACITY_DESC"/>
                <field name="overlayblur" label="PLG_CONTENT_SNAP_GALLERY_OVERLAYBLUR_LABEL" type="number" default="0" description="PLG_CONTENT_SNAP_GALLERY_OVERLAYBLUR_DESC"/>
            </fieldset>
            <fieldset name="about" label="PLG_CONTENT_SNAP_GALLERY_FIELDSET_ABOUT">
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_ABOUT_LABEL" description="PLG_CONTENT_SNAP_GALLERY_ABOUT_DESC"/>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_DOCUMENTATION_LABEL" description="PLG_CONTENT_SNAP_GALLERY_DOCUMENTATION_DESC"/>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_SUPPORT_LABEL" description="PLG_CONTENT_SNAP_GALLERY_SUPPORT_DESC"/>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_CREDITS_LABEL" description="PLG_CONTENT_SNAP_GALLERY_CREDITS_DESC"/>
            </fieldset>
            <fieldset name="advanced" label="PLG_CONTENT_SNAP_GALLERY_FIELDSET_ADVANCED">
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE_LABEL" description="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE_DESC"/>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE1_LABEL" description="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE1_DESC"/>
                <field type="note" label="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE2_LABEL" description="PLG_CONTENT_SNAP_GALLERY_ADVANCED_NOTE2_DESC"/>
                <field name="ajaximages" label="PLG_CONTENT_SNAP_GALLERY_AJAXIMAGES_LABEL" description="PLG_CONTENT_SNAP_GALLERY_AJAXIMAGES_DESC" type="radio" default="0">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
